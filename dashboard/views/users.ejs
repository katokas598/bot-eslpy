<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Пользователи - Discord Bot</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --secondary: #ec4899;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --dark: #0f172a;
            --dark-secondary: #1e293b;
            --dark-tertiary: #334155;
            --text: #f8fafc;
            --text-muted: #94a3b8;
            --gradient: linear-gradient(135deg, #6366f1 0%, #ec4899 100%);
            --glow: 0 0 30px rgba(99, 102, 241, 0.3);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: var(--dark); color: var(--text); min-height: 100vh; }
        
        .bg-animation {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;
            overflow: hidden;
        }
        .bg-animation::before {
            content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
            background: 
                radial-gradient(circle at 20% 80%, rgba(99, 102, 241, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(236, 72, 153, 0.15) 0%, transparent 50%);
            animation: bgMove 20s ease-in-out infinite;
        }
        @keyframes bgMove {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            50% { transform: translate(-5%, -5%) rotate(5deg); }
        }

        .container { max-width: 1400px; margin: 0 auto; padding: 20px; }

        header {
            background: rgba(30, 41, 59, 0.8); backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px;
            padding: 25px 30px; margin-bottom: 30px; animation: slideDown 0.5s ease-out;
        }
        @keyframes slideDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }

        .header-content { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; }

        .logo { display: flex; align-items: center; gap: 15px; }
        .logo-icon {
            width: 50px; height: 50px; background: var(--gradient); border-radius: 15px;
            display: flex; align-items: center; justify-content: center; font-size: 24px;
            box-shadow: var(--glow); animation: pulse 2s ease-in-out infinite;
        }
        @keyframes pulse { 0%, 100% { box-shadow: var(--glow); } 50% { box-shadow: 0 0 50px rgba(99, 102, 241, 0.5); } }
        .logo h1 { font-size: 24px; font-weight: 700; background: var(--gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .logo span { font-size: 12px; color: var(--text-muted); }

        nav { display: flex; gap: 10px; flex-wrap: wrap; }
        nav a {
            color: var(--text); text-decoration: none; padding: 12px 20px;
            background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px; font-weight: 500; transition: all 0.3s ease;
            display: flex; align-items: center; gap: 8px;
        }
        nav a:hover { background: var(--gradient); border-color: transparent; transform: translateY(-3px); box-shadow: var(--glow); }
        nav a.active { background: var(--gradient); border-color: transparent; }

        .section {
            background: rgba(30, 41, 59, 0.8); backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px;
            padding: 30px; animation: fadeInUp 0.5s ease-out;
        }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .section h2 { font-size: 20px; margin-bottom: 25px; display: flex; align-items: center; gap: 10px; }
        .section h2 i { color: var(--primary); }

        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 15px 20px; text-align: left; border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
        th { 
            background: rgba(99, 102, 241, 0.2); color: var(--primary); font-weight: 600;
            text-transform: uppercase; font-size: 12px; letter-spacing: 1px;
        }
        th:first-child { border-radius: 10px 0 0 10px; }
        th:last-child { border-radius: 0 10px 10px 0; }
        tr { transition: all 0.3s ease; animation: fadeInUp 0.5s ease-out backwards; }
        tr:hover { background: rgba(255, 255, 255, 0.05); transform: scale(1.01); }
        
        .level-badge {
            display: inline-flex; align-items: center; gap: 8px; padding: 8px 15px;
            background: var(--gradient); border-radius: 20px; font-weight: 600;
        }

        .xp-bar {
            width: 100px; height: 8px; background: rgba(255, 255, 255, 0.1); border-radius: 10px; overflow: hidden;
        }
        .xp-fill { height: 100%; background: var(--gradient); border-radius: 10px; transition: width 1s ease; }

        .user-cell { display: flex; align-items: center; gap: 12px; }
        .user-avatar {
            width: 40px; height: 40px; border-radius: 10px; background: var(--gradient);
            display: flex; align-items: center; justify-content: center; font-size: 18px;
        }

        .empty-state { text-align: center; padding: 60px 20px; color: var(--text-muted); }
        .empty-state i { font-size: 48px; margin-bottom: 20px; opacity: 0.5; }

        .actions-cell { display: flex; gap: 8px; }
        .action-btn-small {
            padding: 6px 12px; border: none; border-radius: 6px; cursor: pointer;
            font-size: 12px; font-weight: 600; transition: all 0.3s ease;
        }
        .action-btn-small:hover { transform: translateY(-2px); }
        .btn-reset { background: linear-gradient(135deg, #f59e0b, #fbbf24); color: #000; }
        .btn-ban { background: linear-gradient(135deg, #ef4444, #f87171); color: #fff; }
        .btn-mute { background: linear-gradient(135deg, #8b5cf6, #a78bfa); color: #fff; }
        .btn-delete { background: linear-gradient(135deg, #dc2626, #991b1b); color: #fff; }
        .action-btn-small:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

        .modal {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.8); z-index: 1000; align-items: center; justify-content: center;
        }
        .modal.show { display: flex; }
        .modal-content {
            background: var(--dark-secondary); padding: 30px; border-radius: 20px;
            max-width: 400px; width: 90%; border: 1px solid rgba(255,255,255,0.1);
        }
        .modal-content h3 { margin-bottom: 20px; }
        .modal-content input {
            width: 100%; padding: 12px 15px; margin-bottom: 15px;
            background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px; color: var(--text);
        }
        .modal-btns { display: flex; gap: 10px; justify-content: flex-end; }
        .modal-btns button {
            padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;
        }
        .btn-cancel { background: rgba(255,255,255,0.1); color: var(--text); }
        .btn-confirm { background: var(--gradient); color: white; }
    </style>
</head>
<body>
    <div class="bg-animation"></div>
    <div class="container">
        <header>
            <div class="header-content">
                <div class="logo">
                    <div class="logo-icon">🤖</div>
                    <div><h1>Discord Bot</h1><span>ZYC Management</span></div>
                </div>
                <nav>
                    <a href="/"><i class="fas fa-home"></i> Главная</a>
                    <a href="/users" class="active"><i class="fas fa-users"></i> Пользователи</a>
                    <a href="/moderation"><i class="fas fa-shield-alt"></i> Модерация</a>
                    <a href="/tickets"><i class="fas fa-ticket-alt"></i> Тикеты</a>
                    <a href="/settings"><i class="fas fa-cog"></i> Настройки</a>
                </nav>
            </div>
        </header>

        <div class="section">
            <h2><i class="fas fa-users"></i> Все пользователи</h2>
            <% if (users && users.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>ID Пользователя</th>
                        <th>Уровень</th>
                        <th>XP</th>
                        <th>Сообщений</th>
                        <th>Предупреждений</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(function(user, index) { %>
                    <tr style="animation-delay: <%= index * 0.05 %>s">
                        <td>
                            <div class="user-cell">
                                <div class="user-avatar">👤</div>
                                <span><%= user.user_id %></span>
                            </div>
                        </td>
                        <td><span class="level-badge">⭐ <%= user.level %></span></td>
                        <td>
                            <span><%= user.xp %> XP</span>
                            <div class="xp-bar"><div class="xp-fill" style="width: <%= Math.min((user.xp % 100), 100) %>%"></div></div>
                        </td>
                        <td><i class="fas fa-comment"></i> <%= user.messages %></td>
                        <td><span style="color: <%= user.warnings > 0 ? 'var(--danger)' : 'var(--success)' %>"><%= user.warnings %></span></td>
                        <td>
                            <div class="actions-cell">
                                <button class="action-btn-small btn-reset" onclick="resetXP('<%= user.user_id %>')" title="Сбросить XP">
                                    <i class="fas fa-undo"></i>
                                </button>
                                <button class="action-btn-small btn-mute" onclick="showMuteModal('<%= user.user_id %>')" title="Замутить">
                                    <i class="fas fa-comment-slash"></i>
                                </button>
                                <button class="action-btn-small btn-ban" onclick="banUser('<%= user.user_id %>')" title="Забанить">
                                    <i class="fas fa-ban"></i>
                                </button>
                                <button class="action-btn-small btn-delete" onclick="deleteUser('<%= user.user_id %>')" title="Удалить">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            <% } else { %>
            <div class="empty-state">
                <i class="fas fa-user-slash"></i>
                <h3>Нет данных о пользователях</h3>
                <p>Пользователи появятся после первых сообщений на сервере</p>
            </div>
            <% } %>
        </div>
    </div>

    <div class="modal" id="muteModal">
        <div class="modal-content">
            <h3>Замутить пользователя</h3>
            <input type="text" id="muteReason" placeholder="Причина (необязательно)">
            <input type="text" id="muteDuration" placeholder="Время (например: 10m, 1h, 1d)" value="10m">
            <div class="modal-btns">
                <button class="btn-cancel" onclick="closeModal()">Отмена</button>
                <button class="btn-confirm" onclick="confirmMute()">Замутить</button>
            </div>
        </div>
    </div>

    <script>
        let currentMuteUserId = null;

        async function resetXP(userId) {
            if (!confirm('Сбросить XP этому пользователю?')) return;
            const btn = event.target.closest('button');
            btn.disabled = true;
            
            const response = await fetch('/api/user/reset-xp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId })
            });
            
            if (response.ok) {
                alert('XP сброшен!');
                location.reload();
            } else {
                alert('Ошибка');
                btn.disabled = false;
            }
        }

        function showMuteModal(userId) {
            currentMuteUserId = userId;
            document.getElementById('muteModal').classList.add('show');
        }

        function closeModal() {
            document.getElementById('muteModal').classList.remove('show');
            currentMuteUserId = null;
        }

        async function confirmMute() {
            if (!currentMuteUserId) return;
            const reason = document.getElementById('muteReason').value;
            const duration = document.getElementById('muteDuration').value;
            
            const response = await fetch('/api/user/mute', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId: currentMuteUserId, reason, duration })
            });
            
            closeModal();
            if (response.ok) {
                alert('Пользователь замучен!');
                location.reload();
            } else {
                alert('Ошибка');
            }
        }

        async function banUser(userId) {
            if (!confirm('Забанить этого пользователя?')) return;
            
            const response = await fetch('/api/user/ban', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId, reason: 'Забанен через панель' })
            });
            
            if (response.ok) {
                alert('Пользователь забанен!');
            } else {
                alert('Ошибка');
            }
        }

        async function deleteUser(userId) {
            if (!confirm('УДАЛИТЬ этого пользователя из базы данных? Это действие нельзя отменить!')) return;
            
            const btn = event.target.closest('button');
            btn.disabled = true;
            
            const response = await fetch('/api/user/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId })
            });
            
            if (response.ok) {
                alert('Пользователь удалён!');
                location.reload();
            } else {
                alert('Ошибка');
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>