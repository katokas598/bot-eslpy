<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Тикеты - Discord Bot</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #6366f1; --primary-dark: #4f46e5; --secondary: #ec4899;
            --success: #10b981; --warning: #f59e0b; --danger: #ef4444;
            --dark: #0f172a; --dark-secondary: #1e293b; --dark-tertiary: #334155;
            --text: #f8fafc; --text-muted: #94a3b8;
            --gradient: linear-gradient(135deg, #6366f1 0%, #ec4899 100%);
            --glow: 0 0 30px rgba(99, 102, 241, 0.3);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: var(--dark); color: var(--text); min-height: 100vh; }
        
        .bg-animation { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; overflow: hidden; }
        .bg-animation::before {
            content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
            background: radial-gradient(circle at 20% 80%, rgba(99, 102, 241, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(236, 72, 153, 0.15) 0%, transparent 50%);
            animation: bgMove 20s ease-in-out infinite;
        }
        @keyframes bgMove { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(-5%, -5%); } }

        .container { max-width: 1400px; margin: 0 auto; padding: 20px; }

        header {
            background: rgba(30, 41, 59, 0.8); backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px;
            padding: 25px 30px; margin-bottom: 30px; animation: slideDown 0.5s ease-out;
        }
        @keyframes slideDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }

        .header-content { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; }
        .logo { display: flex; align-items: center; gap: 15px; }
        .logo-icon {
            width: 50px; height: 50px; background: var(--gradient); border-radius: 15px;
            display: flex; align-items: center; justify-content: center; font-size: 24px;
            box-shadow: var(--glow); animation: pulse 2s ease-in-out infinite;
        }
        @keyframes pulse { 0%, 100% { box-shadow: var(--glow); } 50% { box-shadow: 0 0 50px rgba(99, 102, 241, 0.5); } }
        .logo h1 { font-size: 24px; font-weight: 700; background: var(--gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .logo span { font-size: 12px; color: var(--text-muted); }

        nav { display: flex; gap: 10px; flex-wrap: wrap; }
        nav a {
            color: var(--text); text-decoration: none; padding: 12px 20px;
            background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px; font-weight: 500; transition: all 0.3s ease;
            display: flex; align-items: center; gap: 8px;
        }
        nav a:hover, nav a.active { background: var(--gradient); border-color: transparent; transform: translateY(-3px); box-shadow: var(--glow); }

        .section {
            background: rgba(30, 41, 59, 0.8); backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px;
            padding: 30px; margin-bottom: 20px; animation: fadeInUp 0.5s ease-out;
        }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .section h2 { font-size: 20px; margin-bottom: 25px; display: flex; align-items: center; gap: 10px; }
        .section h2 i { color: var(--primary); }

        .ticket-card {
            background: rgba(255, 255, 255, 0.05); border-radius: 15px; padding: 20px;
            margin-bottom: 15px; display: flex; align-items: center; gap: 20px;
            transition: all 0.3s ease; animation: fadeInUp 0.5s ease-out backwards;
        }
        .ticket-card:hover { background: rgba(255, 255, 255, 0.1); transform: translateX(10px); }

        .ticket-icon {
            width: 50px; height: 50px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center; font-size: 20px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
        }

        .ticket-info { flex: 1; }
        .ticket-info h4 { font-size: 16px; margin-bottom: 5px; }
        .ticket-info p { color: var(--text-muted); font-size: 13px; }
        .ticket-info .channel { margin-top: 8px; padding: 8px 12px; background: rgba(255,255,255,0.05); border-radius: 8px; display: inline-block; font-size: 12px; }

        .ticket-status {
            padding: 8px 16px; border-radius: 20px; font-weight: 600; font-size: 13px;
        }
        .ticket-status.open { background: linear-gradient(135deg, #10b981, #34d399); }
        .ticket-status.closed { background: linear-gradient(135deg, #ef4444, #f87171); }

        .empty-state { text-align: center; padding: 60px 20px; color: var(--text-muted); }
        .empty-state i { font-size: 48px; margin-bottom: 20px; opacity: 0.5; }

        .stats-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; margin-bottom: 25px; }
        .stat-box {
            background: rgba(255, 255, 255, 0.05); border-radius: 15px; padding: 20px;
            text-align: center; transition: all 0.3s ease;
        }
        .stat-box:hover { transform: translateY(-5px); background: rgba(255, 255, 255, 0.1); }
        .stat-box h3 { font-size: 32px; background: var(--gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .stat-box p { color: var(--text-muted); margin-top: 5px; }

        .ticket-actions {
            display: flex; gap: 10px;
        }
        .btn-action {
            padding: 8px 16px; border: none; border-radius: 8px; cursor: pointer;
            font-weight: 600; font-size: 13px; transition: all 0.3s ease;
            display: flex; align-items: center; gap: 6px;
        }
        .btn-close {
            background: linear-gradient(135deg, #f59e0b, #fbbf24);
            color: #000;
        }
        .btn-close:hover { transform: translateY(-2px); box-shadow: 0 0 15px rgba(245, 158, 11, 0.4); }
        .btn-delete {
            background: linear-gradient(135deg, #ef4444, #f87171);
            color: #fff;
        }
        .btn-delete:hover { transform: translateY(-2px); box-shadow: 0 0 15px rgba(239, 68, 68, 0.4); }
        .btn-close:disabled, .btn-delete:disabled {
            opacity: 0.5; cursor: not-allowed; transform: none;
        }
    </style>
</head>
<body>
    <div class="bg-animation"></div>
    <div class="container">
        <header>
            <div class="header-content">
                <div class="logo">
                    <div class="logo-icon">🤖</div>
                    <div><h1>Discord Bot</h1><span>ZYC Management</span></div>
                </div>
                <nav>
                    <a href="/"><i class="fas fa-home"></i> Главная</a>
                    <a href="/users"><i class="fas fa-users"></i> Пользователи</a>
                    <a href="/moderation"><i class="fas fa-shield-alt"></i> Модерация</a>
                    <a href="/tickets" class="active"><i class="fas fa-ticket-alt"></i> Тикеты</a>
                    <a href="/settings"><i class="fas fa-cog"></i> Настройки</a>
                </nav>
            </div>
        </header>

        <div class="section">
            <h2><i class="fas fa-chart-pie"></i> Статистика тикетов</h2>
            <div class="stats-row">
                <div class="stat-box">
                    <h3><%= tickets.filter(t => t.status === 'open').length %></h3>
                    <p>Открытых</p>
                </div>
                <div class="stat-box">
                    <h3><%= tickets.filter(t => t.status === 'closed').length %></h3>
                    <p>Закрытых</p>
                </div>
            </div>
        </div>

        <div class="section">
            <h2><i class="fas fa-ticket-alt"></i> Все тикеты</h2>
            <% if (tickets && tickets.length > 0) { %>
                <% tickets.forEach(function(t, index) { %>
                <div class="ticket-card" style="animation-delay: <%= index * 0.05 %>s">
                    <div class="ticket-icon">🎫</div>
                    <div class="ticket-info">
                        <h4>Тикет #<%= t.id %></h4>
                        <p>Создатель: <%= t.user_id %></p>
                        <span class="channel"><i class="fas fa-hashtag"></i> <%= t.channel_id %></span>
                    </div>
                    <span class="ticket-status <%= t.status %>"><%= t.status === 'open' ? 'Открыт' : 'Закрыт' %></span>
                    <div class="ticket-actions">
                        <button class="btn-action btn-close" onclick="closeTicket(<%= t.id %>, '<%= t.channel_id %>')" <%= t.status === 'closed' ? 'disabled' : '' %>>
                            <i class="fas fa-lock"></i> Закрыть
                        </button>
                        <button class="btn-action btn-delete" onclick="deleteTicket(<%= t.id %>)">
                            <i class="fas fa-trash"></i> Удалить
                        </button>
                    </div>
                </div>
                <% }); %>
            <% } else { %>
            <div class="empty-state">
                <i class="fas fa-ticket-alt"></i>
                <h3>Нет тикетов</h3>
                <p>Тикеты появятся когда пользователи создадут обращения</p>
            </div>
            <% } %>
        </div>
    </div>

    <script>
        async function closeTicket(ticketId, channelId) {
            if (!confirm('Закрыть тикет? Канал будет удалён.')) return;
            const btn = event.target.closest('button');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Закрытие...';
            
            const response = await fetch('/api/ticket/close', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ticketId, channelId })
            });
            
            if (response.ok) {
                alert('Тикет закрыт!');
                location.reload();
            } else {
                alert('Ошибка при закрытии тикета');
                btn.disabled = false;
            }
        }

        async function deleteTicket(ticketId) {
            if (!confirm('Удалить тикет из базы данных?')) return;
            const btn = event.target.closest('button');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Удаление...';
            
            const response = await fetch('/api/ticket/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ticketId })
            });
            
            if (response.ok) {
                alert('Тикет удалён!');
                location.reload();
            } else {
                alert('Ошибка при удалении тикета');
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>