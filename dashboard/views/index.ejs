<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🎮 Discord Bot Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --secondary: #ec4899;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --dark: #0f172a;
            --dark-secondary: #1e293b;
            --dark-tertiary: #334155;
            --text: #f8fafc;
            --text-muted: #94a3b8;
            --gradient: linear-gradient(135deg, #6366f1 0%, #ec4899 100%);
            --glow: 0 0 30px rgba(99, 102, 241, 0.3);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--dark);
            color: var(--text);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Animated Background */
        .bg-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
        }

        .bg-animation::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: 
                radial-gradient(circle at 20% 80%, rgba(99, 102, 241, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(236, 72, 153, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 40% 40%, rgba(16, 185, 129, 0.1) 0%, transparent 40%);
            animation: bgMove 20s ease-in-out infinite;
        }

        @keyframes bgMove {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            50% { transform: translate(-5%, -5%) rotate(5deg); }
        }

        /* Floating Shapes */
        .floating-shapes {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
        }

        .shape {
            position: absolute;
            opacity: 0.1;
            animation: float 15s ease-in-out infinite;
        }

        .shape:nth-child(1) {
            top: 10%;
            left: 10%;
            width: 100px;
            height: 100px;
            background: var(--gradient);
            border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
            animation-delay: 0s;
        }

        .shape:nth-child(2) {
            top: 60%;
            right: 10%;
            width: 150px;
            height: 150px;
            background: var(--gradient);
            border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
            animation-delay: -5s;
        }

        .shape:nth-child(3) {
            bottom: 20%;
            left: 20%;
            width: 80px;
            height: 80px;
            background: var(--gradient);
            border-radius: 40% 60% 60% 40% / 70% 30% 70% 30%;
            animation-delay: -10s;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            25% { transform: translateY(-20px) rotate(5deg); }
            50% { transform: translateY(0) rotate(0deg); }
            75% { transform: translateY(20px) rotate(-5deg); }
        }

        /* Layout */
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        /* Header */
        header {
            background: rgba(30, 41, 59, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 25px 30px;
            margin-bottom: 30px;
            animation: slideDown 0.5s ease-out;
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-icon {
            width: 50px;
            height: 50px;
            background: var(--gradient);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            box-shadow: var(--glow);
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { box-shadow: var(--glow); }
            50% { box-shadow: 0 0 50px rgba(99, 102, 241, 0.5); }
        }

        .logo h1 {
            font-size: 24px;
            font-weight: 700;
            background: var(--gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .logo span {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* Navigation */
        nav {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        nav a {
            color: var(--text);
            text-decoration: none;
            padding: 12px 20px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            font-weight: 500;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        nav a:hover {
            background: var(--gradient);
            border-color: transparent;
            transform: translateY(-3px);
            box-shadow: var(--glow);
        }

        nav a.active {
            background: var(--gradient);
            border-color: transparent;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: rgba(30, 41, 59, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 25px;
            text-align: center;
            transition: all 0.3s ease;
            animation: fadeInUp 0.5s ease-out backwards;
        }

        .stat-card:nth-child(1) { animation-delay: 0.1s; }
        .stat-card:nth-child(2) { animation-delay: 0.2s; }
        .stat-card:nth-child(3) { animation-delay: 0.3s; }
        .stat-card:nth-child(4) { animation-delay: 0.4s; }
        .stat-card:nth-child(5) { animation-delay: 0.5s; }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .stat-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary);
            box-shadow: var(--glow);
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            margin: 0 auto 15px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .stat-card:nth-child(1) .stat-icon { background: linear-gradient(135deg, #6366f1, #8b5cf6); }
        .stat-card:nth-child(2) .stat-icon { background: linear-gradient(135deg, #ec4899, #f472b6); }
        .stat-card:nth-child(3) .stat-icon { background: linear-gradient(135deg, #10b981, #34d399); }
        .stat-card:nth-child(4) .stat-icon { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
        .stat-card:nth-child(5) .stat-icon { background: linear-gradient(135deg, #ef4444, #f87171); }

        .stat-card h3 {
            font-size: 32px;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .stat-card p {
            color: var(--text-muted);
            font-size: 14px;
        }

        /* Section */
        .section {
            background: rgba(30, 41, 59, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 20px;
            animation: fadeInUp 0.5s ease-out 0.6s backwards;
        }

        .section h2 {
            font-size: 20px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section h2 i {
            color: var(--primary);
        }

        /* Quick Actions */
        .quick-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }

        .action-btn {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px 20px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            color: var(--text);
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .action-btn:hover {
            background: var(--gradient);
            border-color: transparent;
            transform: scale(1.02);
        }

        .action-btn i {
            font-size: 20px;
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .action-btn:hover i {
            background: rgba(255, 255, 255, 0.2);
        }

        /* Server List */
        .server-list {
            display: grid;
            gap: 15px;
        }

        .server-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            transition: all 0.3s ease;
        }

        .server-item:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        .server-icon {
            width: 50px;
            height: 50px;
            border-radius: 15px;
            background: var(--gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .server-info h4 {
            font-size: 16px;
            margin-bottom: 3px;
        }

        .server-info p {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* Online Indicator */
        .status-indicator {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-left: auto;
        }

        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--success);
            animation: blink 2s ease-in-out infinite;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        /* Responsive */
        @media (max-width: 768px) {
            .header-content {
                flex-direction: column;
                text-align: center;
            }

            nav {
                justify-content: center;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .stat-card {
                padding: 20px;
            }

            .stat-card h3 {
                font-size: 24px;
            }
        }

        /* Loading Animation */
        .loader {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: var(--primary);
            animation: spin 1s ease-in-out infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .system-btns {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }
        .system-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 15px 20px;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .system-btn:hover:not(:disabled) {
            transform: translateY(-3px);
        }
        .system-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        .btn-restart {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: white;
        }
        .btn-restart:hover:not(:disabled) {
            box-shadow: 0 0 25px rgba(99, 102, 241, 0.5);
        }
        .btn-shutdown {
            background: linear-gradient(135deg, #ef4444, #f87171);
            color: white;
        }
        .btn-shutdown:hover:not(:disabled) {
            box-shadow: 0 0 25px rgba(239, 68, 68, 0.5);
        }
        .btn-clear {
            background: linear-gradient(135deg, #f59e0b, #fbbf24);
            color: #000;
        }
        .btn-clear:hover:not(:disabled) {
            box-shadow: 0 0 25px rgba(245, 158, 11, 0.5);
        }
    </style>
</head>
<body>
    <div class="bg-animation"></div>
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <div class="container">
        <header>
            <div class="header-content">
                <div class="logo">
                    <div class="logo-icon">🤖</div>
                    <div>
                        <h1>Discord Bot</h1>
                        <span>ZYC Management System</span>
                    </div>
                </div>
                <nav>
                    <a href="/" class="active"><i class="fas fa-home"></i> Главная</a>
                    <a href="/users"><i class="fas fa-users"></i> Пользователи</a>
                    <a href="/moderation"><i class="fas fa-shield-alt"></i> Модерация</a>
                    <a href="/tickets"><i class="fas fa-ticket-alt"></i> Тикеты</a>
                    <a href="/settings"><i class="fas fa-cog"></i> Настройки</a>
                </nav>
            </div>
        </header>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-users"></i></div>
                <h3><%= stats.totalUsers %></h3>
                <p>Пользователей</p>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-comments"></i></div>
                <h3><%= stats.totalMessages %></h3>
                <p>Сообщений</p>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-exclamation-triangle"></i></div>
                <h3><%= stats.totalWarnings %></h3>
                <p>Предупреждений</p>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-gavel"></i></div>
                <h3><%= stats.totalBans %></h3>
                <p>Банов</p>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-ticket"></i></div>
                <h3><%= stats.totalTickets %></h3>
                <p>Тикетов</p>
            </div>
        </div>

        <div class="section">
            <h2><i class="fas fa-bolt"></i> Быстрые действия</h2>
            <div class="quick-actions">
                <a href="/settings" class="action-btn">
                    <i class="fas fa-cog"></i>
                    <div>
                        <strong>Настройки</strong>
                        <p>Конфигурация бота</p>
                    </div>
                </a>
                <a href="/moderation" class="action-btn">
                    <i class="fas fa-shield-alt"></i>
                    <div>
                        <strong>Модерация</strong>
                        <p>История действий</p>
                    </div>
                </a>
                <a href="/users" class="action-btn">
                    <i class="fas fa-chart-line"></i>
                    <div>
                        <strong>Статистика</strong>
                        <p>Активность пользователей</p>
                    </div>
                </a>
            </div>
        </div>

        <div class="section">
            <h2><i class="fas fa-server"></i> Подключенные сервера</h2>
            <div class="server-list" id="serverList">
                <div class="empty-state" id="serverLoading">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>Загрузка серверов...</p>
                </div>
            </div>
        </div>

        <div class="section">
            <h2><i class="fas fa-cogs"></i> Управление ботом</h2>
            <div class="system-btns">
                <button class="system-btn btn-clear" onclick="clearMemory()">
                    <i class="fas fa-broom"></i> Очистить память
                </button>
                <button class="system-btn btn-restart" onclick="restartBot()">
                    <i class="fas fa-redo"></i> Перезапустить бота
                </button>
                <button class="system-btn btn-shutdown" onclick="shutdownBot()">
                    <i class="fas fa-power-off"></i> Выключить бота
                </button>
            </div>
        </div>
    </div>

    <script>
        // Load servers on page load
        async function loadServers() {
            try {
                const response = await fetch('/api/servers');
                const servers = await response.json();
                const serverList = document.getElementById('serverList');
                const loading = document.getElementById('serverLoading');
                if (loading) loading.remove();
                
                if (servers.length === 0) {
                    serverList.innerHTML = '<div class="empty-state"><i class="fas fa-server"></i><p>Нет подключённых серверов</p></div>';
                    return;
                }
                
                serverList.innerHTML = servers.map(server => `
                    <div class="server-item">
                        <div class="server-icon">${server.icon ? `<img src="${server.icon}" style="width:50px;height:50px;border-radius:15px;">` : '🎮'}</div>
                        <div class="server-info">
                            <h4>${server.name}</h4>
                            <p>${server.memberCount} участников</p>
                        </div>
                        <div class="status-indicator">
                            <div class="status-dot"></div>
                            <span>Онлайн</span>
                        </div>
                    </div>
                `).join('');
            } catch (e) {
                console.error('Error loading servers:', e);
            }
        }

        async function clearMemory() {
            if (!confirm('Очистить всю память бота? Это удалит все предупреждения, баны, мюты, тикеты и сбросит XP всех пользователей!')) return;
            
            const btn = event.target;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Очистка...';
            
            const response = await fetch('/api/clear-memory', { method: 'POST' });
            const data = await response.json();
            
            if (data.success) {
                alert('Память очищена!');
                location.reload();
            } else {
                alert('Ошибка: ' + data.error);
                btn.disabled = false;
            }
        }

        async function restartBot() {
            if (!confirm('Перезапустить бота? Бот будет недоступен несколько секунд.')) return;
            
            const btn = event.target;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Перезапуск...';
            
            await fetch('/api/restart', { method: 'POST' });
            alert('Запрос на перезапуск отправлен! Переподключитесь через 10-15 секунд.');
        }

        async function shutdownBot() {
            if (!confirm('ВЫКЛЮЧИТЬ БОТА? Бот не будет работать пока вы его не запустите вручную!')) return;
            
            const btn = event.target;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Выключение...';
            
            await fetch('/api/shutdown', { method: 'POST' });
            alert('Бот выключен!');
        }

        // Add smooth scroll
        document.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', function(e) {
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = '';
                }, 100);
            });
        });

        // Add parallax effect on mouse move
        document.addEventListener('mousemove', (e) => {
            const shapes = document.querySelectorAll('.shape');
            const x = (e.clientX / window.innerWidth - 0.5) * 20;
            const y = (e.clientY / window.innerHeight - 0.5) * 20;

            shapes.forEach((shape, index) => {
                const speed = (index + 1) * 5;
                shape.style.transform = `translate(${x * speed}px, ${y * speed}px)`;
            });
        });

        // Load servers on init
        loadServers();
    </script>
</body>
</html>