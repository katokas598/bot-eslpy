<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Уровни и награды - Discord Bot</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --secondary: #ec4899;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --dark: #0f172a;
            --dark-secondary: #1e293b;
            --dark-tertiary: #334155;
            --text: #f8fafc;
            --text-muted: #94a3b8;
            --gradient: linear-gradient(135deg, #6366f1 0%, #ec4899 100%);
            --glow: 0 0 30px rgba(99, 102, 241, 0.3);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: var(--dark); color: var(--text); min-height: 100vh; }
        
        .bg-animation { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; overflow: hidden; }
        .bg-animation::before {
            content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
            background: radial-gradient(circle at 20% 80%, rgba(99, 102, 241, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(236, 72, 153, 0.15) 0%, transparent 50%);
            animation: bgMove 20s ease-in-out infinite;
        }
        @keyframes bgMove { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(-5%, -5%); } }

        .container { max-width: 1400px; margin: 0 auto; padding: 20px; }

        header {
            background: rgba(30, 41, 59, 0.8); backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px;
            padding: 25px 30px; margin-bottom: 30px; animation: slideDown 0.5s ease-out;
        }
        @keyframes slideDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }

        .header-content { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; }
        .logo { display: flex; align-items: center; gap: 15px; }
        .logo-icon {
            width: 50px; height: 50px; background: var(--gradient); border-radius: 15px;
            display: flex; align-items: center; justify-content: center; font-size: 24px;
            box-shadow: var(--glow); animation: pulse 2s ease-in-out infinite;
        }
        @keyframes pulse { 0%, 100% { box-shadow: var(--glow); } 50% { box-shadow: 0 0 50px rgba(99, 102, 241, 0.5); } }
        .logo h1 { font-size: 24px; font-weight: 700; background: var(--gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .logo span { font-size: 12px; color: var(--text-muted); }

        nav { display: flex; gap: 10px; flex-wrap: wrap; }
        nav a {
            color: var(--text); text-decoration: none; padding: 12px 20px;
            background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px; font-weight: 500; transition: all 0.3s ease;
            display: flex; align-items: center; gap: 8px;
        }
        nav a:hover, nav a.active { background: var(--gradient); border-color: transparent; transform: translateY(-3px); box-shadow: var(--glow); }

        .section {
            background: rgba(30, 41, 59, 0.8); backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px;
            padding: 30px; margin-bottom: 20px; animation: fadeInUp 0.5s ease-out;
        }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .section h2 { font-size: 20px; margin-bottom: 25px; display: flex; align-items: center; gap: 10px; }
        .section h2 i { color: var(--primary); }

        .settings-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;
        }
        .setting-card {
            background: rgba(255, 255, 255, 0.05); border-radius: 15px; padding: 20px;
            transition: all 0.3s ease;
        }
        .setting-card:hover { background: rgba(255, 255, 255, 0.1); }
        .setting-card h3 {
            font-size: 14px; color: var(--text-muted); margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px;
        }
        .setting-card .value {
            font-size: 28px; font-weight: 700; color: var(--primary);
        }

        .form-group { margin-bottom: 20px; }
        .form-group label {
            display: block; margin-bottom: 10px; font-weight: 500; color: var(--text-muted);
        }
        .form-group input, .form-group select {
            width: 100%; padding: 15px 20px; background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px;
            color: var(--text); font-size: 15px; transition: all 0.3s ease;
        }
        .form-group input:focus, .form-group select:focus {
            outline: none; border-color: var(--primary);
            box-shadow: 0 0 20px rgba(99, 102, 241, 0.2);
        }

        .btn {
            padding: 15px 30px; background: var(--gradient); border: none; border-radius: 12px;
            color: white; font-size: 16px; font-weight: 600; cursor: pointer;
            transition: all 0.3s ease; display: inline-flex; align-items: center; gap: 10px;
        }
        .btn:hover { transform: translateY(-3px); box-shadow: var(--glow); }

        .leaderboard-tabs { display: flex; gap: 10px; margin-bottom: 20px; }
        .tab-btn {
            padding: 12px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px; color: var(--text); cursor: pointer; transition: all 0.3s ease;
        }
        .tab-btn.active { background: var(--gradient); border-color: transparent; }

        .leaderboard-item {
            display: flex; align-items: center; gap: 15px; padding: 15px;
            background: rgba(255, 255, 255, 0.05); border-radius: 12px; margin-bottom: 10px;
            transition: all 0.3s ease;
        }
        .leaderboard-item:hover { background: rgba(255, 255, 255, 0.1); transform: translateX(10px); }
        .leaderboard-item .rank { font-size: 20px; font-weight: 700; width: 40px; }
        .leaderboard-item .rank.gold { color: #ffd700; }
        .leaderboard-item .rank.silver { color: #c0c0c0; }
        .leaderboard-item .rank.bronze { color: #cd7f32; }
        .leaderboard-item .info { flex: 1; }
        .leaderboard-item .info .name { font-weight: 600; }
        .leaderboard-item .info .details { color: var(--text-muted); font-size: 13px; }
        .leaderboard-item .xp { font-weight: 700; color: var(--primary); }

        .achievements-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; }
        .achievement-card {
            background: rgba(255, 255, 255, 0.05); border-radius: 12px; padding: 15px;
            display: flex; align-items: center; gap: 15px;
        }
        .achievement-icon { font-size: 30px; }
        .achievement-info h4 { font-size: 14px; margin-bottom: 5px; }
        .achievement-info p { color: var(--text-muted); font-size: 12px; }

        .success-message {
            position: fixed; top: 20px; right: 20px; background: var(--success); color: white;
            padding: 15px 25px; border-radius: 12px; font-weight: 600; z-index: 1000;
            animation: slideIn 0.3s ease;
        }
        @keyframes slideIn { from { transform: translateX(100%); } to { transform: translateX(0); } }

        .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; margin-bottom: 25px; }
        .stat-box {
            background: rgba(255, 255, 255, 0.05); border-radius: 12px; padding: 20px; text-align: center;
        }
        .stat-box h3 { font-size: 24px; background: var(--gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .stat-box p { color: var(--text-muted); font-size: 12px; margin-top: 5px; }
    </style>
</head>
<body>
    <div class="bg-animation"></div>
    <div class="container">
        <header>
            <div class="header-content">
                <div class="logo">
                    <div class="logo-icon">⬆️</div>
                    <div><h1>Уровни и награды</h1><span>ZYC Bot System</span></div>
                </div>
                <nav>
                    <a href="/"><i class="fas fa-home"></i> Главная</a>
                    <a href="/users"><i class="fas fa-users"></i> Пользователи</a>
                    <a href="/levels" class="active"><i class="fas fa-trophy"></i> Уровни</a>
                    <a href="/settings"><i class="fas fa-cog"></i> Настройки</a>
                </nav>
            </div>
        </header>

        <div class="section">
            <h2><i class="fas fa-cogs"></i> Настройки системы уровней</h2>
            <div class="settings-grid">
                <div class="setting-card">
                    <h3>XP за сообщение</h3>
                    <div class="value"><%= levelSettings?.xp_per_message || 1 %></div>
                </div>
                <div class="setting-card">
                    <h3>XP за голос (мин)</h3>
                    <div class="value"><%= levelSettings?.xp_per_voice_minute || 2 %></div>
                </div>
                <div class="setting-card">
                    <h3>Ежедневная награда</h3>
                    <div class="value">+<%= levelSettings?.daily_reward || 10 %> XP</div>
                </div>
                <div class="setting-card">
                    <h3>Бонус за серию</h3>
                    <div class="value">+<%= levelSettings?.streak_bonus || 5 %> XP/день</div>
                </div>
            </div>
        </div>

        <div class="section">
            <h2><i class="fas fa-sliders-h"></i> Изменить настройки</h2>
            <form id="levelsForm">
                <div class="settings-grid">
                    <div class="form-group">
                        <label>XP за сообщение</label>
                        <input type="number" name="xp_per_message" value="<%= levelSettings?.xp_per_message || 1 %>" min="1" max="100">
                    </div>
                    <div class="form-group">
                        <label>XP за минуту в голосе</label>
                        <input type="number" name="xp_per_voice_minute" value="<%= levelSettings?.xp_per_voice_minute || 2 %>" min="1" max="50">
                    </div>
                    <div class="form-group">
                        <label>Ежедневная награда (XP)</label>
                        <input type="number" name="daily_reward" value="<%= levelSettings?.daily_reward || 10 %>" min="1" max="1000">
                    </div>
                    <div class="form-group">
                        <label>Бонус за серию (XP/день)</label>
                        <input type="number" name="streak_bonus" value="<%= levelSettings?.streak_bonus || 5 %>" min="1" max="100">
                    </div>
                    <div class="form-group">
                        <label>Макс. бонус за серию (XP)</label>
                        <input type="number" name="max_streak_bonus" value="<%= levelSettings?.max_streak_bonus || 50 %>" min="1" max="1000">
                    </div>
                </div>
                <button type="submit" class="btn">
                    <i class="fas fa-save"></i> Сохранить настройки
                </button>
            </form>
        </div>

        <div class="section">
            <h2><i class="fas fa-trophy"></i> Лидерборды</h2>
            <div class="leaderboard-tabs">
                <button class="tab-btn active" onclick="showTab('weekly')">За неделю</button>
                <button class="tab-btn" onclick="showTab('monthly')">За месяц</button>
                <button class="tab-btn" onclick="showTab('alltime')">За всё время</button>
            </div>

            <div id="weekly" class="leaderboard-content">
                <% weeklyTop.forEach((user, index) => { %>
                <div class="leaderboard-item">
                    <span class="rank <%= index === 0 ? 'gold' : index === 1 ? 'silver' : index === 2 ? 'bronze' : '' %>">
                        <%= index + 1 %>
                    </span>
                    <div class="info">
                        <div class="name"><%= user.user_id %></div>
                        <div class="details">Level <%= user.level %> • <%= user.messages %> сообщений</div>
                    </div>
                    <span class="xp"><%= user.weekly_xp %> XP</span>
                </div>
                <% }); %>
            </div>

            <div id="monthly" class="leaderboard-content" style="display:none;">
                <% monthlyTop.forEach((user, index) => { %>
                <div class="leaderboard-item">
                    <span class="rank <%= index === 0 ? 'gold' : index === 1 ? 'silver' : index === 2 ? 'bronze' : '' %>">
                        <%= index + 1 %>
                    </span>
                    <div class="info">
                        <div class="name"><%= user.user_id %></div>
                        <div class="details">Level <%= user.level %> • <%= user.messages %> сообщений</div>
                    </div>
                    <span class="xp"><%= user.monthly_xp %> XP</span>
                </div>
                <% }); %>
            </div>

            <div id="alltime" class="leaderboard-content" style="display:none;">
                <% allTimeTop.forEach((user, index) => { %>
                <div class="leaderboard-item">
                    <span class="rank <%= index === 0 ? 'gold' : index === 1 ? 'silver' : index === 2 ? 'bronze' : '' %>">
                        <%= index + 1 %>
                    </span>
                    <div class="info">
                        <div class="name"><%= user.user_id %></div>
                        <div class="details">Level <%= user.level %> • <%= user.messages %> сообщений</div>
                    </div>
                    <span class="xp"><%= user.xp %> XP</span>
                </div>
                <% }); %>
            </div>
        </div>

        <div class="section">
            <h2><i class="fas fa-medal"></i> Достижения</h2>
            <div class="achievements-list">
                <% achievements.forEach(achievement => { %>
                <div class="achievement-card">
                    <div class="achievement-icon">
                        <%= achievement.type === 'messages' ? '💬' : achievement.type === 'level' ? '⬆️' : '🔥' %>
                    </div>
                    <div class="achievement-info">
                        <h4><%= achievement.name %></h4>
                        <p><%= achievement.count %> <%= achievement.type === 'messages' ? 'сообщений' : achievement.type === 'level' ? 'уровень' : 'дней' %> • +<%= achievement.reward %> XP</p>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>

        <div class="section">
            <h2><i class="fas fa-star"></i> Роли за уровни</h2>
            <div class="achievements-list">
                <% roles.forEach(role => { %>
                <div class="achievement-card">
                    <div class="achievement-icon">⬆️</div>
                    <div class="achievement-info">
                        <h4>Уровень <%= role.level %></h4>
                        <p>Награда: +<%= role.rewardXp || 0 %> XP</p>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </div>

    <script>
        function showTab(tabName) {
            document.querySelectorAll('.leaderboard-content').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById(tabName).style.display = 'block';
            event.target.classList.add('active');
        }

        document.getElementById('levelsForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData);

            try {
                const response = await fetch('/api/levels', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const msg = document.createElement('div');
                    msg.className = 'success-message';
                    msg.textContent = '✅ Настройки сохранены!';
                    document.body.appendChild(msg);
                    setTimeout(() => msg.remove(), 3000);
                }
            } catch (e) {
                console.error('Error:', e);
            }
        });
    </script>
</body>
</html>